<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>BioScout - Sign Up</title>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700&family=Poppins:wght@300;400;500;600&display=swap" rel="stylesheet">
    <style>
        * { margin:0; padding:0; box-sizing:border-box; }
        body {
            font-family: 'Poppins', sans-serif;
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            background-color: #050505;
        }

        .split-container {
            display: flex;
            width: 900px;
            height: 600px; /* Slightly taller for signup form */
            background: #000;
            box-shadow: 0 20px 50px rgba(0,0,0,0.5);
            overflow: hidden;
            border-radius: 4px;
        }

        .left-panel {
            flex: 1;
            padding: 40px 50px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            background-color: #000;
            color: #fff;
            position: relative;
        }

        .right-panel {
            flex: 1;
            background-image: url("{{ url_for('static', filename='images/login_bg.gif') }}");
            background-size: cover;
            background-position: center;
            position: relative;
        }
        .right-panel::before {
            content: "";
            position: absolute;
            inset: 0;
            background: rgba(0,0,0,0.2); 
        }

        h1 {
            font-family: 'Playfair Display', serif;
            font-size: 2.5rem;
            margin-bottom: 1rem;
            font-weight: 400;
            letter-spacing: 1px;
        }

        .subtitle {
            font-size: 0.75rem;
            color: #888;
            margin-bottom: 25px;
            margin-top: -10px;
        }

        .input-group {
            position: relative;
            margin-bottom: 20px;
        }
        
        .field-label {
            font-size: 0.7rem;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            color: #666;
            margin-bottom: 5px;
            display: block;
            font-weight: 600;
        }

        input {
            width: 100%;
            background: transparent;
            border: none;
            border-bottom: 1px solid #333;
            padding: 8px 0;
            color: #fff;
            font-size: 0.95rem;
            font-family: 'Poppins', sans-serif;
            transition: border-color 0.3s;
        }
        input:focus {
            outline: none;
            border-bottom-color: #2ecc71;
        }

        button.btn-submit {
            width: 100%;
            padding: 15px;
            background: #44bd32;
            border: none;
            border-radius: 30px;
            color: #000;
            font-size: 0.85rem;
            font-weight: 700;
            letter-spacing: 1px;
            text-transform: uppercase;
            cursor: pointer;
            margin-top: 15px;
            transition: all 0.3s;
        }
        button.btn-submit:hover {
            background: #2ecc71;
            box-shadow: 0 5px 20px rgba(46,204,113,0.3);
        }

        .links {
            margin-top: 20px;
            text-align: center;
            font-size: 0.75rem;
            color: #666;
        }
        .links a {
            color: #fff;
            text-decoration: none;
            transition: color 0.3s;
        }

        .flash-messages { margin-bottom: 15px; }
        .alert { 
            padding: 8px; margin-bottom: 8px; border-radius: 4px; font-size: 0.75rem; 
        }
        .alert-error {
            background: rgba(231, 76, 60, 0.1); border: 1px solid #e74c3c; color: #e74c3c;
        }
    </style>
</head>
<body>

<div class="split-container">
    <!-- LEFT: Signup Form -->
    <div class="left-panel">
        <h1>Sign Up</h1>
        <p class="subtitle">Join the BioScout community</p>

        {% with messages = get_flashed_messages(with_categories=true) %}
            {% if messages %}
                <div class="flash-messages">
                {% for category, message in messages %}
                    <div class="alert alert-{{ category }}">{{ message }}</div>
                {% endfor %}
                </div>
            {% endif %}
        {% endwith %}

        <form action="{{ url_for('signup') }}" method="POST">
            <div class="input-group">
                <label class="field-label">Full Name</label>
                <input type="text" name="name" required>
            </div>

            <div class="input-group">
                <label class="field-label">Email Address</label>
                <input type="email" name="email" required>
            </div>
            
            <div class="input-group">
                <label class="field-label">Password</label>
                <input type="password" name="password" required>
            </div>

            <div class="input-group">
                <label class="field-label">Confirm Password</label>
                <input type="password" name="confirm_password" required>
            </div>

            <button type="submit" class="btn-submit">Create Account</button>
        </form>

        <div class="links">
            Already have an account? <a href="{{ url_for('login') }}">Login</a>
        </div>
    </div>

    <!-- RIGHT: Image/GIF Panel -->
    <div class="right-panel">
        <div style="position:absolute; top:30px; right:0; background:#44bd32; color:#000; 
                    padding:10px 20px; font-weight:700; font-size:0.8rem; letter-spacing:1px;
                    text-transform:uppercase;">
            BioScout
        </div>
    </div>
</div>

</body>
</html>

        .flash-messages {
            margin-bottom: 20px;
        }

        .alert {
            padding: 10px;
            border-radius: 5px;
            list-style: none;
        }

        .alert-error {
            background: rgba(231, 76, 60, 0.2);
            border: 1px solid #e74c3c;
            color: #ffcccc;
        }

        .alert-success {
            background: rgba(46, 204, 113, 0.2);
            border: 1px solid #2ecc71;
            color: #ccffdd;
        }

        .password-wrapper {
            position: relative;
        }

        .password-wrapper input {
            padding-right: 45px;
        }

        .eye-btn {
            position: absolute;
            right: 12px;
            /* Adjust position to center vertically within the INPUT field, not the wrapper */
            top: auto;
            bottom: 5px;
            height: 48px; /* Match input height roughly */
            display: flex;
            align-items: center;
            background: none;
            border: none;
            color: rgba(255, 255, 255, 0.7); /* Lighter color for visibility on dark bg */
            cursor: pointer;
            font-size: 1.1rem;
            padding: 0;
            width: auto;
            margin: 0;
            z-index: 10;
        }

        .eye-btn:hover {
            color: #fff;
            transform: none;
            box-shadow: none;
        }

        .req { color: #e74c3c; font-weight: 700; margin-left: 2px; }

        .field-label {
            display: block;
            margin-bottom: 8px;
            font-size: 0.9rem;
            color: #ccc;
            text-align: left;
        }

        /* Password rules checklist */
        .pw-rules {
            text-align: left;
            margin: -10px 0 15px 0;
            padding: 12px 14px;
            background: rgba(0,0,0,0.25);
            border-radius: 8px;
            border: 1px solid rgba(255,255,255,0.08);
        }
        .pw-rules p {
            margin: 0 0 6px;
            font-size: 0.78rem;
            color: #aaa;
            font-weight: 600;
        }
        .pw-rule {
            font-size: 0.78rem;
            margin: 3px 0;
            color: #e74c3c;
            transition: color 0.3s;
        }
        .pw-rule.pass { color: #2ecc71; }
        .pw-rule::before { content: '\2717  '; }
        .pw-rule.pass::before { content: '\2713  '; }

        /* Remaining fields message */
        .remaining-msg {
            margin-top: 10px;
            font-size: 0.8rem;
            color: #f39c12;
            text-align: left;
            min-height: 1.2em;
        }
    </style>
</head>
<body>

    <div class="auth-container">
        <h1>Sign Up</h1>

        {% with messages = get_flashed_messages(with_categories=true) %}
            {% if messages %}
                <ul class="flash-messages">
                {% for category, message in messages %}
                    <li class="alert alert-{{ category }}">{{ message }}</li>
                {% endfor %}
                </ul>
            {% endif %}
        {% endwith %}

        <form action="{{ url_for('signup') }}" method="POST" id="signupForm">
            <div class="input-group">
                <label class="field-label">Username <span class="req">*</span></label>
                <input type="text" name="username" id="username" placeholder="Username" required>
            </div>
            <div class="input-group">
                <label class="field-label">Email Address <span class="req">*</span></label>
                <input type="email" name="email" id="email" placeholder="Email Address" required>
            </div>
            <div class="input-group password-wrapper">
                <label class="field-label">Password <span class="req">*</span></label>
                <input type="password" name="password" id="password" placeholder="Password" required>
                <button type="button" class="eye-btn" onclick="togglePassword()">&#128065;</button>
            </div>

            <!-- Live password rules -->
            <div class="pw-rules">
                <p>Password must contain:</p>
                <div class="pw-rule" id="rule-len">At least 8 characters</div>
                <div class="pw-rule" id="rule-upper">One uppercase letter</div>
                <div class="pw-rule" id="rule-lower">One lowercase letter</div>
                <div class="pw-rule" id="rule-digit">One digit (0-9)</div>
                <div class="pw-rule" id="rule-special">One special character (!@#$%^&*)</div>
            </div>

            <div class="remaining-msg" id="remainingMsg"></div>

            <button type="submit" id="submitBtn" disabled style="opacity:0.5;cursor:not-allowed;">Create Account</button>
        </form>

        <div class="links">
            <p>Already have an account? <a href="{{ url_for('login') }}">Login</a></p>
            <p><a href="/">Back to Home</a></p>
        </div>
    </div>

    <script>
        function togglePassword() {
            const pw = document.getElementById('password');
            pw.type = pw.type === 'password' ? 'text' : 'password';
        }

        // Live password validation
        const pw = document.getElementById('password');
        const username = document.getElementById('username');
        const email = document.getElementById('email');
        const submitBtn = document.getElementById('submitBtn');
        const remainingMsg = document.getElementById('remainingMsg');

        const rules = [
            { id: 'rule-len',     test: v => v.length >= 8 },
            { id: 'rule-upper',   test: v => /[A-Z]/.test(v) },
            { id: 'rule-lower',   test: v => /[a-z]/.test(v) },
            { id: 'rule-digit',   test: v => /[0-9]/.test(v) },
            { id: 'rule-special', test: v => /[!@#$%^&*(),.?":{}|<>]/.test(v) },
        ];

        function validateForm() {
            const val = pw.value;
            let allPass = true;
            rules.forEach(r => {
                const el = document.getElementById(r.id);
                const ok = r.test(val);
                el.classList.toggle('pass', ok);
                if (!ok) allPass = false;
            });

            // Check remaining fields
            const missing = [];
            if (!username.value.trim()) missing.push('Username');
            if (!email.value.trim()) missing.push('Email');
            if (!allPass) missing.push('Valid password');

            if (missing.length > 0 && (username.value || email.value || val)) {
                remainingMsg.textContent = 'Still needed: ' + missing.join(', ');
            } else {
                remainingMsg.textContent = '';
            }

            const formReady = allPass && username.value.trim() && email.value.trim();
            submitBtn.disabled = !formReady;
            submitBtn.style.opacity = formReady ? '1' : '0.5';
            submitBtn.style.cursor = formReady ? 'pointer' : 'not-allowed';
        }

        pw.addEventListener('input', validateForm);
        username.addEventListener('input', validateForm);
        email.addEventListener('input', validateForm);
    </script>

</body>
</html>