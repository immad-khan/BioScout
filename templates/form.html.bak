<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Species Observation Form</title>
    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            margin: 0;
            padding: 0;
            background-image: url('bio1.jpg');
            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;
            background-attachment: fixed;
        }
        /* Optional dark overlay on background */
        body::before {
            content: "";
            position: fixed;
            top: 0; left: 0;
            width: 100vw; height: 100vh;
            background-color: rgba(0,0,0,0.4);
            z-index: -1;
        }
        .container {
            max-width: 600px;
            margin: 40px auto;
            padding: 25px 30px;
            background-color: rgba(135, 206, 235, 0.9); /* sky blue with 90% opacity */
            border-radius: 12px;
            box-shadow: 0 8px 24px rgba(0,0,0,0.12);
        }
        h1 {
            text-align: center;
            color: #333;
            margin-bottom: 25px;
        }
        label {
            display: block;
            font-weight: 600;
            margin-bottom: 8px;
            color: #444;
        }
        input[type="text"],
        input[type="date"],
        input[type="file"],
        textarea {
            width: 100%;
            padding: 10px 12px;
            margin-bottom: 20px;
            border: 1.8px solid #ddd;
            border-radius: 6px;
            font-size: 1rem;
            transition: border-color 0.3s ease;
            resize: vertical;
            box-sizing: border-box;
        }
        input[type="text"]:focus,
        input[type="date"]:focus,
        input[type="file"]:focus,
        textarea:focus {
            border-color: #28a745;
            outline: none;
        }
        textarea {
            min-height: 90px;
        }
        input[type="submit"] {
            width: 100%;
            background-color: #28a745;
            color: white;
            border: none;
            font-size: 1.15rem;
            font-weight: 700;
            padding: 14px 0;
            border-radius: 8px;
            cursor: pointer;
            transition: background-color 0.3s ease;
        }
        input[type="submit"]:hover {
            background-color: #218838;
        }
        .note {
            color: #666;
            font-size: 0.9rem;
            margin-top: -15px;
            margin-bottom: 20px;
        }
        /* Added styling for notification */
        .notification {
            padding: 15px;
            margin: 20px 0;
            border-radius: 6px;
            display: none;
        }
        .success {
            background-color: #d4edda;
            color: #155724;
            border: 1px solid #c3e6cb;
        }
        .error {
            background-color: #f8d7da;
            color: #721c24;
            border: 1px solid #f5c6cb;
        }
        /* Loading indicator */
        .loading {
            display: none;
            text-align: center;
            margin: 15px 0;
        }
        .loading span {
            display: inline-block;
            height: 15px;
            width: 15px;
            background-color: #28a745;
            border-radius: 50%;
            margin: 0 3px;
            animation: pulse 1.4s infinite ease-in-out;
        }
        .loading span:nth-child(2) {
            animation-delay: 0.2s;
        }
        .loading span:nth-child(3) {
            animation-delay: 0.4s;
        }
        @keyframes pulse {
            0%, 100% {
                transform: scale(0.5);
                opacity: 0.5;
            }
            50% {
                transform: scale(1);
                opacity: 1;
            }
        }
    </style>
</head>
<body>

    <div class="container">
        <h1>Species Observation Form</h1>
        
        <!-- Notification messages -->
        <div id="successNotification" class="notification success">
            Your observation has been successfully submitted!
        </div>
        <div id="errorNotification" class="notification error">
            There was an error submitting your observation. Please try again.
        </div>
        
        <form id="observationForm" method="post" enctype="multipart/form-data">
            <label for="species">Species Name:</label>
            <input type="text" id="species" name="species" required placeholder="Enter species name" />
            
            <label for="date">Date Observed:</label>
            <input type="date" id="date" name="date" required />
            
            <label for="location">Location:</label>
            <input type="text" id="location" name="location" required placeholder="Enter location" />
            
            <label for="image">Upload Image:</label>
            <input type="file" id="image" name="file" accept="image/*" />
            <div class="note">Optional. Supported formats: jpg, png, gif. Image will be analyzed for species classification.</div>
            
            <label for="notes">Notes:</label>
            <textarea id="notes" name="notes" placeholder="Additional details or observations (optional)"></textarea>
            
            <!-- Loading indicator -->
            <div id="loadingIndicator" class="loading">
                <span></span>
                <span></span>
                <span></span>
            </div>
            
            <input type="submit" value="Submit" />
        </form>
    </div>

    <script>
        // Set today's date as the default value for the date input
        document.getElementById('date').valueAsDate = new Date();
        
        document.getElementById('observationForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            
            // Show loading indicator
            const loadingIndicator = document.getElementById('loadingIndicator');
            loadingIndicator.style.display = 'block';
            
            // Hide any existing notifications
            document.getElementById('successNotification').style.display = 'none';
            document.getElementById('errorNotification').style.display = 'none';
            
            const formData = new FormData(this);
            
            try {
                // Submit the form data to your Flask endpoint - make sure this URL is correct!
                // Change to the actual URL where your Flask server is running
                const response = await fetch('http://localhost:5000/upload', {
                    method: 'POST',
                    body: formData
                });
                
                // Hide loading indicator
                loadingIndicator.style.display = 'none';
                
                console.log("Response status:", response.status);
                
                if (response.ok) {
                    // Try to parse the JSON response
                    const data = await response.json();
                    console.log("Response data:", data);
                    
                    // Show success message
                    const successNotification = document.getElementById('successNotification');
                    successNotification.style.display = 'block';
                    
                    // If there's a predicted species from the model, show it
                    if (data.predicted_species && !document.getElementById('species').value) {
                        successNotification.textContent = `Observation submitted successfully! The model identified this species as: ${data.predicted_species}`;
                    }
                    
                    // Reset the form after successful submission
                    this.reset();
                    
                    // Reset the date to today's date
                    document.getElementById('date').valueAsDate = new Date();
                    
                    // Scroll to top to show the success message
                    window.scrollTo({ top: 0, behavior: 'smooth' });
                } else {
                    // If the server response was not ok, show error message
                    document.getElementById('errorNotification').style.display = 'block';
                    console.error('Server returned error status:', response.status);
                }
            } catch (error) {
                // Hide loading indicator
                loadingIndicator.style.display = 'none';
                
                // Show error message
                document.getElementById('errorNotification').style.display = 'block';
                console.error('Error submitting form:', error);
            }
        });
    </script>
</body>
</html>